<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>FF_FirstName_Required</fullName>
    <active>false</active>
    <description>Prevents First name from being left blank</description>
    <errorConditionFormula>ISBLANK(FirstName)</errorConditionFormula>
    <errorMessage>First Name must be populated.</errorMessage>
</ValidationRule>
