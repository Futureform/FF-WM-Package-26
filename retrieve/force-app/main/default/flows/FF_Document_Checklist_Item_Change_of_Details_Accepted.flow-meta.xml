                <leftValueReference>Get_Case.FF_Address_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Correspondence</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Correspondence_Address_0</targetReference>
            </connector>
            <label>Both Addresses</label>
        </rules>
        <rules>
            <name>Date_Of_Birth</name>
