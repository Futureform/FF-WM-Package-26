            </conditions>
            <connector>
                <targetReference>Update_Date_Of_Birth</targetReference>
            </connector>
            <label>Date Of Birth</label>
        </rules>
        <rules>
            <name>Name_Change</name>
            <conditionLogic>(1 AND 3) OR (2 OR 4)</conditionLogic>
            <conditions>
                <leftValueReference>Get_Case.FF_First_Name__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>Get_Case.Account.FirstName</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Case.FF_Last_Name__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>Get_Case.Account.LastName</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Case.FF_First_Name__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Case.FF_Last_Name__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Account_Record</targetReference>
            </connector>
            <label>Name Change</label>
        </rules>
