                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Correspondence</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Case.FF_Same_Details_Address__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Correspondence_Address</targetReference>
            </connector>
            <label>Address - Correspondence</label>
        </rules>
        <rules>
            <name>BothAddresses</name>
            <conditionLogic>1 AND (2 OR 3)</conditionLogic>
            <conditions>
                <leftValueReference>Get_Case.FF_Same_Details_Address__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Case.FF_Address_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Residential</stringValue>
                </rightValue>
            </conditions>
