    <description>Triggered when an Opportunity is Closed Won. Checks for an existing Financial Account by number; if found, reuses it, otherwise creates a new one with a RecordType matching the Opportunity&apos;s record type. Either way, resolves the Account as Person vs Household and ensures the appropriate FinancialAccountParty records exist (Person: single party; Household: one per Contact Role), skipping any that already exist on the Financial Account, then links the Financial Account to the Opportunity.</description>
    <environments>Default</environments>
    <formulas>
        <name>FinancialAccountRecordTypeDeveloperName</name>
        <dataType>String</dataType>
        <expression>CASE(
    {!$Record.RecordType.DeveloperName},
    &quot;FF_Bank_Account&quot;, &quot;FFBankAccount&quot;,
    &quot;FF_Investment&quot;,   &quot;FFInvestment&quot;,
    &quot;FF_Mortgage&quot;,     &quot;FFMortgage&quot;,
    &quot;FF_Pension&quot;,      &quot;FFPension&quot;,
    &quot;FF_Protection&quot;,   &quot;FFProtection&quot;,
    &quot;&quot;
)</expression>
    </formulas>
    <formulas>
        <name>FinancialAccountType</name>
        <dataType>String</dataType>
        <expression>CASE(
    {!$Record.RecordType.DeveloperName},
    &quot;FF_Bank_Account&quot;,  &quot;Bank Account&quot;,
    &quot;FF_Pension&quot;,       &quot;Pension&quot;,
    &quot;FF_Investment&quot;,    &quot;Investment Account&quot;,
    &quot;FF_Mortgage&quot;,      &quot;Mortgage&quot;,
    &quot;FF_Protection&quot;,    &quot;Protection&quot;,
    &quot;&quot;
)</expression>
    </formulas>
    <interviewLabel>FF - Opportunity - Create new Financial Account {!$Flow.CurrentDateTime}</interviewLabel>
    <label>FF - Opportunity - Create Financial Account</label>
