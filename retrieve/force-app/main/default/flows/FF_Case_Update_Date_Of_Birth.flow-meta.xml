        <locationX>446</locationX>
        <locationY>458</locationY>
        <defaultConnector>
            <targetReference>Set_Case_Values</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No, other status</defaultConnectorLabel>
        <rules>
            <name>Yes_new_Case</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Case_Details.Status</leftValueReference>
