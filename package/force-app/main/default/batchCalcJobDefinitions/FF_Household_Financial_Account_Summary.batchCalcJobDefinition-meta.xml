        <name>Retrieve_Person_Accounts</name>
        <primarySourceName>Retrieve_Accounts_and_Contacts</primarySourceName>
        <secondarySourceName>Filter_Contacts</secondarySourceName>
        <type>LeftOuter</type>
    </joins>
    <joins>
        <description>Retrieves the total balance of financial accounts of the household members.</description>
        <fields>
            <alias>BalanceAmount</alias>
            <sourceFieldName>BalanceAmount</sourceFieldName>
            <sourceName>Filter_Total_Balance</sourceName>
        </fields>
        <fields>
            <alias>FinancialAccountBalanceId</alias>
            <sourceFieldName>FinancialAccountBalanceId</sourceFieldName>
            <sourceName>Filter_Total_Balance</sourceName>
        </fields>
        <fields>
            <alias>FinancialAccountId</alias>
            <sourceFieldName>FinancialAccountId</sourceFieldName>
            <sourceName>Retrieve_Financial_Accounts</sourceName>
        </fields>
        <fields>
            <alias>FinancialAccountType</alias>
            <sourceFieldName>FinancialAccountType</sourceFieldName>
            <sourceName>Retrieve_Financial_Accounts</sourceName>
        </fields>
        <fields>
            <alias>HouseholdAccountId</alias>
            <sourceFieldName>HouseholdAccountId</sourceFieldName>
            <sourceName>Retrieve_Financial_Accounts</sourceName>
        </fields>
        <fields>
            <alias>IsHeldAway</alias>
            <sourceFieldName>IsHeldAway</sourceFieldName>
            <sourceName>Retrieve_Financial_Accounts</sourceName>
        </fields>
        <fields>
            <alias>IsManaged</alias>
            <sourceFieldName>IsManaged</sourceFieldName>
            <sourceName>Retrieve_Financial_Accounts</sourceName>
        </fields>
        <joinKeys>
            <primarySourceFieldName>FinancialAccountId</primarySourceFieldName>
            <secondarySourceFieldName>FinancialAccountId</secondarySourceFieldName>
        </joinKeys>
        <label>Retrieve Total Balance of Financial Accounts</label>
        <name>Retrieve_Total_Balance_of_Financial_Accounts</name>
        <primarySourceName>Retrieve_Financial_Accounts</primarySourceName>
        <secondarySourceName>Filter_Total_Balance</secondarySourceName>
        <type>LeftOuter</type>
    </joins>
    <joins>
        <description>Retrieves the total value of all the bank deposits associated with the household.</description>
        <fields>
            <alias>AccountFinancialSummaryId</alias>
            <sourceFieldName>AccountFinancialSummaryId</sourceFieldName>
            <sourceName>Retrieve_Account_Financial_Summary_Records</sourceName>
        </fields>
        <fields>
            <alias>HouseholdAccountId</alias>
            <sourceFieldName>HouseholdAccountId</sourceFieldName>
            <sourceName>Retrieve_Account_Financial_Summary_Records</sourceName>
        </fields>
        <fields>
            <alias>TotalBankDepositValue</alias>
            <sourceFieldName>TotalBankDepositValue</sourceFieldName>
            <sourceName>Aggregate_Savings_and_Checking_Balances</sourceName>
        </fields>
        <joinKeys>
            <primarySourceFieldName>HouseholdAccountId</primarySourceFieldName>
            <secondarySourceFieldName>HouseholdAccountId</secondarySourceFieldName>
        </joinKeys>
        <label>Retrieve Total Bank Deposit Value</label>
        <name>Retrieve_Total_Bank_Deposit_Value</name>
        <primarySourceName>Retrieve_Account_Financial_Summary_Records</primarySourceName>
        <secondarySourceName>Aggregate_Savings_and_Checking_Balances</secondarySourceName>
        <type>LeftOuter</type>
    </joins>
    <joins>
        <description>Retrieves the total combined value of all financial accounts held with the financial institutions along with total bank deposit value.</description>
        <fields>
            <alias>AccountFinancialSummaryId</alias>
            <sourceFieldName>AccountFinancialSummaryId</sourceFieldName>
            <sourceName>Retrieve_Total_Bank_Deposit_Value</sourceName>
        </fields>
        <fields>
            <alias>HouseholdAccountId</alias>
            <sourceFieldName>HouseholdAccountId</sourceFieldName>
            <sourceName>Retrieve_Total_Bank_Deposit_Value</sourceName>
        </fields>
        <fields>
            <alias>TotalBankDepositValue</alias>
            <sourceFieldName>TotalBankDepositValue</sourceFieldName>
            <sourceName>Retrieve_Total_Bank_Deposit_Value</sourceName>
        </fields>
        <fields>
            <alias>TotalHeldFinancialAccountValue</alias>
            <sourceFieldName>TotalHeldFinancialAccountValue</sourceFieldName>
            <sourceName>Aggregate_Held_Financial_Account_Value</sourceName>
