    <definitionRunMode>Batch</definitionRunMode>
    <description>Computes individual totals for managed investments, total investments, outstanding credit amounts, financial account values, and financial account balances across all financial accounts associated with a household.</description>
    <doesGenAllFailedRecords>false</doesGenAllFailedRecords>
    <executionPlatformObjectType>None</executionPlatformObjectType>
    <executionPlatformType>CRMA</executionPlatformType>
    <filters>
        <criteria>
            <operator>Equals</operator>
            <sequence>1</sequence>
            <sourceFieldName>IsIncludedInGroup</sourceFieldName>
            <value>true</value>
        </criteria>
        <description>Filters account contact relation records for household members using the Included In Group flag.</description>
        <filterCondition>1</filterCondition>
        <isDynamicFilter>false</isDynamicFilter>
        <label>Filter Account Contact Relation Records</label>
        <name>Filter_Account_Contact_Relation_Records</name>
        <sourceName>Account_Contact_Relation</sourceName>
    </filters>
    <filters>
        <criteria>
            <operator>Equals</operator>
            <sequence>1</sequence>
            <sourceFieldName>IsPersonAccount</sourceFieldName>
            <value>true</value>
        </criteria>
        <description>Filters contact records that are associated with person accounts.</description>
        <filterCondition>1</filterCondition>
        <isDynamicFilter>false</isDynamicFilter>
        <label>Filter Contacts</label>
        <name>Filter_Contacts</name>
        <sourceName>Contact</sourceName>
    </filters>
    <filters>
        <criteria>
            <operator>Equals</operator>
            <sequence>1</sequence>
            <sourceFieldName>FinancialAccountBalanceType</sourceFieldName>
            <value>Total Balance</value>
        </criteria>
        <description>Filters total balance from financial account balance records.</description>
        <filterCondition>1</filterCondition>
        <isDynamicFilter>false</isDynamicFilter>
        <label>Filter Total Balance</label>
        <name>Filter_Total_Balance</name>
        <sourceName>Financial_Account_Balance</sourceName>
    </filters>
    <filters>
        <criteria>
            <operator>Equals</operator>
            <sequence>1</sequence>
            <sourceFieldName>Role</sourceFieldName>
            <value>Owner</value>
        </criteria>
        <description>Filters financial account parties who own financial accounts linked to household members.</description>
        <filterCondition>1</filterCondition>
        <isDynamicFilter>false</isDynamicFilter>
        <label>Filter Financial Account Parties by Owner</label>
        <name>Filter_Financial_Account_Parties_by_Owner</name>
        <sourceName>Financial_Account_Party</sourceName>
    </filters>
    <filters>
        <criteria>
            <operator>Equals</operator>
            <sequence>1</sequence>
            <sourceFieldName>PRG_Type</sourceFieldName>
            <value>Household</value>
        </criteria>
        <description>Filters party relationship group records based on the household type.</description>
        <filterCondition>1</filterCondition>
        <isDynamicFilter>false</isDynamicFilter>
        <label>Filter Household Accounts</label>
        <name>Filter_Household_Accounts</name>
        <sourceName>Party_Relationship_Group</sourceName>
    </filters>
    <filters>
        <criteria>
            <operator>In</operator>
            <sequence>1</sequence>
            <sourceFieldName>FinancialAccountType</sourceFieldName>
            <value>Checking,Savings</value>
        </criteria>
        <description>Filters financial accounts of type checking and savings.</description>
        <filterCondition>1</filterCondition>
        <isDynamicFilter>false</isDynamicFilter>
        <label>Filter Savings and Checking Financial Accounts</label>
        <name>Filter_Savings_and_Checking_Financial_Accounts</name>
        <sourceName>Get_Unique_Financial_Account_Balances</sourceName>
    </filters>
    <filters>
        <criteria>
            <operator>Equals</operator>
            <sequence>1</sequence>
            <sourceFieldName>IsHeldAway</sourceFieldName>
            <value>false</value>
        </criteria>
        <description>Filters financial accounts held with the financial institution.</description>
        <filterCondition>1</filterCondition>
        <isDynamicFilter>false</isDynamicFilter>
        <label>Filter Held Financial Accounts</label>
        <name>Filter_Held_Financial_Accounts</name>
        <sourceName>Get_Unique_Financial_Account_Balances</sourceName>
    </filters>
    <filters>
        <criteria>
            <operator>In</operator>
            <sequence>1</sequence>
            <sourceFieldName>FinancialAccountType</sourceFieldName>
            <value>Home Equity Line of Credit,Automotive Loan,Credit Card,Loan,Mortgage</value>
        </criteria>
        <description>Filters the outstanding credit accounts, such as automotive loans, credit cards, home equity line of credits, mortgages, and loan accounts.</description>
        <filterCondition>1</filterCondition>
        <isDynamicFilter>false</isDynamicFilter>
        <label>Filter Outstanding Credit Accounts</label>
        <name>Filter_Outstanding_Credit_Accounts</name>
        <sourceName>Get_Unique_Financial_Account_Balances</sourceName>
    </filters>
    <filters>
        <criteria>
            <operator>Equals</operator>
            <sequence>1</sequence>
            <sourceFieldName>FinancialAccountType</sourceFieldName>
            <value>Investment Account</value>
        </criteria>
        <description>Filters the investment accounts of the household members.</description>
        <filterCondition>1</filterCondition>
        <isDynamicFilter>false</isDynamicFilter>
        <label>Filter Investment Accounts</label>
        <name>Filter_Investment_Accounts</name>
        <sourceName>Get_Unique_Financial_Account_Balances</sourceName>
    </filters>
    <filters>
        <criteria>
            <operator>Equals</operator>
            <sequence>1</sequence>
            <sourceFieldName>IsManaged</sourceFieldName>
            <value>true</value>
        </criteria>
        <description>Filters the investment accounts managed by the financial institution.</description>
        <filterCondition>1</filterCondition>
        <isDynamicFilter>false</isDynamicFilter>
        <label>Filter Managed Investment Accounts</label>
        <name>Filter_Managed_Investment_Accounts</name>
        <sourceName>Filter_Investment_Accounts</sourceName>
    </filters>
    <filters>
        <criteria>
            <operator>IsNull</operator>
            <sequence>1</sequence>
            <sourceFieldName>AccountFinancialSummaryId</sourceFieldName>
        </criteria>
        <description>Filters accounts that don&apos;t have associated account financial summary records.</description>
        <filterCondition>1</filterCondition>
        <isDynamicFilter>false</isDynamicFilter>
        <label>Filter Accounts without Account Financial Summary Records</label>
        <name>Filter_Accounts_without_Account_Financial_Summary_Records</name>
        <sourceName>Set_Last_Updated_Timestamp</sourceName>
    </filters>
    <filters>
        <criteria>
            <operator>IsNotNull</operator>
            <sequence>1</sequence>
            <sourceFieldName>AccountFinancialSummaryId</sourceFieldName>
        </criteria>
        <description>Filters accounts that have associated account financial summary records.</description>
        <filterCondition>1</filterCondition>
        <isDynamicFilter>false</isDynamicFilter>
        <label>Filter Accounts with Account Financial Summary Records</label>
        <name>Filter_Accounts_with_Account_Financial_Summary_Records</name>
        <sourceName>Set_Last_Updated_Timestamp</sourceName>
    </filters>
    <isTemplate>false</isTemplate>
    <joins>
