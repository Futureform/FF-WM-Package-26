        <description>Retrieves the financial accounts of the household members by using their financial account IDs.</description>
        <fields>
            <alias>FinancialAccountId</alias>
            <sourceFieldName>FinancialAccountId</sourceFieldName>
            <sourceName>Retrieve_Financial_Account_IDs</sourceName>
        </fields>
        <fields>
            <alias>FinancialAccountType</alias>
            <sourceFieldName>FinancialAccountType</sourceFieldName>
            <sourceName>Financial_Account</sourceName>
        </fields>
        <fields>
            <alias>HouseholdAccountId</alias>
            <sourceFieldName>HouseholdAccountId</sourceFieldName>
            <sourceName>Retrieve_Financial_Account_IDs</sourceName>
        </fields>
        <fields>
            <alias>IsHeldAway</alias>
            <sourceFieldName>IsHeldAway</sourceFieldName>
            <sourceName>Financial_Account</sourceName>
        </fields>
        <fields>
            <alias>IsManaged</alias>
            <sourceFieldName>IsManaged</sourceFieldName>
            <sourceName>Financial_Account</sourceName>
        </fields>
        <joinKeys>
            <primarySourceFieldName>FinancialAccountId</primarySourceFieldName>
            <secondarySourceFieldName>FinancialAccountId</secondarySourceFieldName>
        </joinKeys>
        <label>Retrieve Financial Accounts</label>
        <name>Retrieve_Financial_Accounts</name>
        <primarySourceName>Retrieve_Financial_Account_IDs</primarySourceName>
        <secondarySourceName>Financial_Account</secondarySourceName>
        <type>LeftOuter</type>
    </joins>
    <joins>
        <description>Retrieves the financial account IDs of the household members by using their corresponding financial account party records.</description>
        <fields>
            <alias>FinancialAccountId</alias>
            <sourceFieldName>FinancialAccountId</sourceFieldName>
            <sourceName>Filter_Financial_Account_Parties_by_Owner</sourceName>
        </fields>
        <fields>
            <alias>HouseholdAccountId</alias>
            <sourceFieldName>HouseholdAccountId</sourceFieldName>
            <sourceName>Retrieve_Person_Accounts</sourceName>
        </fields>
        <joinKeys>
            <primarySourceFieldName>PersonAccountId</primarySourceFieldName>
            <secondarySourceFieldName>AccountId</secondarySourceFieldName>
        </joinKeys>
        <label>Retrieve Financial Account IDs</label>
        <name>Retrieve_Financial_Account_IDs</name>
        <primarySourceName>Retrieve_Person_Accounts</primarySourceName>
        <secondarySourceName>Filter_Financial_Account_Parties_by_Owner</secondarySourceName>
        <type>LeftOuter</type>
    </joins>
    <joins>
        <description>Retrieves the person accounts of the household members by using their contact IDs.</description>
        <fields>
            <alias>HouseholdAccountId</alias>
            <sourceFieldName>HouseholdAccountId</sourceFieldName>
            <sourceName>Retrieve_Accounts_and_Contacts</sourceName>
        </fields>
        <fields>
            <alias>PersonAccountId</alias>
            <sourceFieldName>AccountId</sourceFieldName>
            <sourceName>Filter_Contacts</sourceName>
        </fields>
        <joinKeys>
            <primarySourceFieldName>ContactId</primarySourceFieldName>
            <secondarySourceFieldName>ContactId</secondarySourceFieldName>
        </joinKeys>
