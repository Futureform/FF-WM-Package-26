<?xml version="1.0" encoding="UTF-8"?>
<BatchCalcJobDefinition xmlns="http://soap.sforce.com/2006/04/metadata">
    <aggregates>
        <description>Removes duplicate financial account balance records and groups them by their household, financial account type, and ownership.</description>
        <fields>
            <aggregateFunction>Max</aggregateFunction>
            <alias>BalanceAmount</alias>
            <sourceFieldName>BalanceAmount</sourceFieldName>
        </fields>
        <groupBy>HouseholdAccountId</groupBy>
        <groupBy>FinancialAccountId</groupBy>
        <groupBy>FinancialAccountBalanceId</groupBy>
        <groupBy>FinancialAccountType</groupBy>
        <groupBy>IsHeldAway</groupBy>
        <groupBy>IsManaged</groupBy>
        <label>Get Unique Financial Account Balances</label>
        <name>Get_Unique_Financial_Account_Balances</name>
        <sourceName>Retrieve_Total_Balance_of_Financial_Accounts</sourceName>
    </aggregates>
    <aggregates>
        <description>Calculates the total balance of financial accounts of type savings and checking.</description>
        <fields>
            <aggregateFunction>Sum</aggregateFunction>
            <alias>TotalBankDepositValue</alias>
            <sourceFieldName>BalanceAmount</sourceFieldName>
        </fields>
        <groupBy>HouseholdAccountId</groupBy>
        <label>Aggregate Savings and Checking Balances</label>
        <name>Aggregate_Savings_and_Checking_Balances</name>
        <sourceName>Filter_Savings_and_Checking_Financial_Accounts</sourceName>
    </aggregates>
    <aggregates>
        <description>Calculates the total combined value of all financial accounts held with the financial institution.</description>
        <fields>
            <aggregateFunction>Sum</aggregateFunction>
            <alias>TotalHeldFinancialAccountValue</alias>
            <sourceFieldName>BalanceAmount</sourceFieldName>
        </fields>
        <groupBy>HouseholdAccountId</groupBy>
        <label>Aggregate Held Financial Account Value</label>
        <name>Aggregate_Held_Financial_Account_Value</name>
        <sourceName>Filter_Held_Financial_Accounts</sourceName>
    </aggregates>
    <aggregates>
        <description>Calculates the sum of the outstanding amounts of automotive loans, credit cards, home equity line of credits, mortgages, and loan accounts associated with the household.</description>
        <fields>
            <aggregateFunction>Sum</aggregateFunction>
            <alias>TotalOutstandingCreditAmount</alias>
            <sourceFieldName>BalanceAmount</sourceFieldName>
        </fields>
        <groupBy>HouseholdAccountId</groupBy>
        <label>Aggregate Outstanding Credit Amount</label>
        <name>Aggregate_Outstanding_Credit_Amount</name>
        <sourceName>Filter_Outstanding_Credit_Accounts</sourceName>
    </aggregates>
    <aggregates>
        <description>Calculates the total value of all the investment accounts associated with the household.</description>
        <fields>
            <aggregateFunction>Sum</aggregateFunction>
            <alias>TotalInvestmentValue</alias>
            <sourceFieldName>BalanceAmount</sourceFieldName>
        </fields>
        <groupBy>HouseholdAccountId</groupBy>
        <label>Aggregate Investment Value</label>
        <name>Aggregate_Investment_Value</name>
        <sourceName>Filter_Investment_Accounts</sourceName>
    </aggregates>
    <aggregates>
        <description>Calculates the total managed investment value of all the investment accounts managed by the financial institution.</description>
        <fields>
            <aggregateFunction>Sum</aggregateFunction>
            <alias>TotalManagedInvestmentValue</alias>
            <sourceFieldName>BalanceAmount</sourceFieldName>
        </fields>
        <groupBy>HouseholdAccountId</groupBy>
        <label>Aggregate Managed Investment Value</label>
        <name>Aggregate_Managed_Investment_Value</name>
        <sourceName>Filter_Managed_Investment_Accounts</sourceName>
    </aggregates>
    <dataSpaceApiName>default</dataSpaceApiName>
