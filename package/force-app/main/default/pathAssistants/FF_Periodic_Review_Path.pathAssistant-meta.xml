<?xml version="1.0" encoding="UTF-8"?>
<PathAssistant xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <entityName>ApplicationForm</entityName>
    <fieldName>FF_Review_Status__c</fieldName>
    <masterLabel>FF Periodic Review Path</masterLabel>
    <pathAssistantSteps>
        <fieldNames>DueDate</fieldNames>
        <info>Review is due. Send the client the invite, then set the status to Contacted.</info>
        <picklistValueName>Due</picklistValueName>
    </pathAssistantSteps>
    <pathAssistantSteps>
        <fieldNames>FF_Review_Attempts__c</fieldNames>
        <fieldNames>FF_Last_Contact_Logged__c</fieldNames>
        <info>Add 1 to Attempts each time you contact the client. When a time is agreed, create an Event linked to this review.</info>
        <picklistValueName>Contacted</picklistValueName>
    </pathAssistantSteps>
    <pathAssistantSteps>
        <fieldNames>FF_Review_Meeting_Date__c</fieldNames>
        <info>Meeting booked. Hold the review, then record the Interaction Summary and outcome.</info>
        <picklistValueName>Booked</picklistValueName>
    </pathAssistantSteps>
    <pathAssistantSteps>
        <fieldNames>FF_Review_Outcome__c</fieldNames>
        <info>Review done. The Account Last and Next Review Dates update automatically.</info>
        <picklistValueName>Completed</picklistValueName>
    </pathAssistantSteps>
    <pathAssistantSteps>
        <info>Client did not attend. A rearrange task is created. Set Contacted again once you reach them.</info>
        <picklistValueName>Missed</picklistValueName>
    </pathAssistantSteps>
    <pathAssistantSteps>
        <fieldNames>FF_Review_Attempts__c</fieldNames>
        <info>No reply after the agreed attempts. Escalated to Compliance if there is still no response.</info>
        <picklistValueName>Non-Response</picklistValueName>
    </pathAssistantSteps>
    <pathAssistantSteps>
        <fieldNames>FF_Escalation_Reason__c</fieldNames>
        <info>Escalated to the Compliance Queue. Compliance contacts the client.</info>
        <picklistValueName>Escalated</picklistValueName>
    </pathAssistantSteps>
    <recordTypeName>FF_Periodic_Review</recordTypeName>
</PathAssistant>
