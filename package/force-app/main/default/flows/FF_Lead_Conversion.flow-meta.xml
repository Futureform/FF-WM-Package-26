    <formulas>
        <name>ApplicationName</name>
        <dataType>String</dataType>
        <expression>IF(
            {!$Record.Has_Joint_Applicant__c},
            TRIM({!$Record.FirstName}) &amp; &quot; &amp; &quot; &amp; TRIM({!$Record.Spouse_First_Name__c}) &amp; &quot; &quot; &amp; TRIM({!$Record.LastName}) &amp; &quot; Application&quot;,
            TRIM({!$Record.FirstName}) &amp; &quot; &quot; &amp; TRIM({!$Record.LastName}) &amp; &quot; Application&quot;
        )</expression>
    </formulas>
    <formulas>
