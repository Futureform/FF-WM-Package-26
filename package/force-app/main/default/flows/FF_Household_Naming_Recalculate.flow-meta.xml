<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Add_Contact_Id_To_Collection</name>
        <label>Add Contact Id To Collection</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>ContactIds</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Household_Members.ContactId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Household_Members</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Build_Names</name>
        <label>Build Names</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varFirstNames</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>FirstNamesFormula</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varSurnames</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>SurnamesFormula</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Contacts</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Check_Names_Built</name>
        <label>Check Names Built</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No Members Found</defaultConnectorLabel>
        <rules>
            <name>Names_Built</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varFirstNames</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue></stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Household_Name</targetReference>
            </connector>
            <label>Names Built</label>
        </rules>
    </decisions>
    <description>Rebuilds a Household Account Name from its current Household Members. Reads AccountContactRelation records with IsPrimaryGroup true, collects distinct surnames and all first names, and updates the Household Name to the format Surname Household (FirstName1 &amp; FirstName2). Called from the ACR Change and ACR Delete flows.</description>
    <environments>Default</environments>
    <formulas>
        <name>FirstNamesFormula</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!varFirstNames}), {!Loop_Contacts.FirstName}, {!varFirstNames} &amp; &quot; &amp; &quot; &amp; {!Loop_Contacts.FirstName})</expression>
    </formulas>
    <formulas>
        <name>HouseholdNameFormula</name>
        <dataType>String</dataType>
        <expression>{!varSurnames} &amp; &quot; Household (&quot; &amp; {!varFirstNames} &amp; &quot;)&quot;</expression>
    </formulas>
    <formulas>
        <name>SurnamesFormula</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!varSurnames}), {!Loop_Contacts.LastName}, IF(CONTAINS({!varSurnames}, {!Loop_Contacts.LastName}), {!varSurnames}, {!varSurnames} &amp; &quot; &amp; &quot; &amp; {!Loop_Contacts.LastName}))</expression>
    </formulas>
    <interviewLabel>FF - Household Naming - Recalculate {!$Flow.CurrentDateTime}</interviewLabel>
    <label>FF - Household Naming - Recalculate</label>
    <loops>
        <name>Loop_Contacts</name>
        <label>Loop Contacts</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Household_Contacts</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Build_Names</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Check_Names_Built</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <name>Loop_Household_Members</name>
        <label>Loop Household Members</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Household_Members</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Add_Contact_Id_To_Collection</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Get_Household_Contacts</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Household_Contacts</name>
        <label>Get Household Contacts</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Contacts</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>In</operator>
            <value>
                <elementReference>ContactIds</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Contact</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Household_Members</name>
        <label>Get Household Members</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Household_Members</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AccountId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>HouseholdAccountId</elementReference>
            </value>
        </filters>
        <filters>
            <field>IsPrimaryGroup</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Id</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>ExcludeAcrId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>AccountContactRelation</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Household_Name</name>
        <label>Update Household Name</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>HouseholdAccountId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Name</field>
            <value>
                <elementReference>HouseholdNameFormula</elementReference>
            </value>
        </inputAssignments>
        <object>Account</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Household_Members</targetReference>
        </connector>
    </start>
    <status>Draft</status>
    <variables>
        <name>ContactIds</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>ExcludeAcrId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
        <value>
            <stringValue></stringValue>
        </value>
    </variables>
    <variables>
        <name>HouseholdAccountId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varFirstNames</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <value>
            <stringValue></stringValue>
        </value>
    </variables>
    <variables>
        <name>varSurnames</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <value>
            <stringValue></stringValue>
        </value>
    </variables>
</Flow>
