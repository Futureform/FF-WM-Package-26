<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <description>Missed creates a rearrange task. Completed sets the Account Last and Next Review Date.</description>
    <decisions>
        <name>Which_Status</name><label>Which Status</label><locationX>0</locationX><locationY>0</locationY>
        <defaultConnectorLabel>Other</defaultConnectorLabel>
        <rules>
            <name>Missed</name><conditionLogic>and</conditionLogic>
            <conditions><leftValueReference>$Record.FF_Review_Status__c</leftValueReference><operator>EqualTo</operator><rightValue><stringValue>Missed</stringValue></rightValue></conditions>
            <connector><targetReference>Rearrange_Task</targetReference></connector>
            <label>Missed</label>
        </rules>
        <rules>
            <name>Completed</name><conditionLogic>and</conditionLogic>
            <conditions><leftValueReference>$Record.FF_Review_Status__c</leftValueReference><operator>EqualTo</operator><rightValue><stringValue>Completed</stringValue></rightValue></conditions>
            <connector><targetReference>Get_Account</targetReference></connector>
            <label>Completed</label>
        </rules>
    </decisions>
    <formulas>
        <name>LastDate</name><dataType>Date</dataType><expression>IF(ISBLANK({!$Record.FF_Review_Meeting_Date__c}), TODAY(), {!$Record.FF_Review_Meeting_Date__c})</expression>
    </formulas>
    <formulas>
        <name>Months</name><dataType>Number</dataType><scale>0</scale><expression>IF(TEXT({!Get_Account.FF_Review_Frequency__c}) = '6 months', 6, 12)</expression>
    </formulas>
    <formulas>
        <name>NextDate</name><dataType>Date</dataType><expression>ADDMONTHS({!LastDate}, {!Months})</expression>
    </formulas>
    <formulas>
        <name>TaskDue</name><dataType>Date</dataType><expression>TODAY() + 2</expression>
    </formulas>
    <label>FF Review Status Changes</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Rearrange_Task</name><label>Rearrange Task</label><locationX>0</locationX><locationY>0</locationY>
        <inputAssignments><field>ActivityDate</field><value><elementReference>TaskDue</elementReference></value></inputAssignments>
        <inputAssignments><field>OwnerId</field><value><elementReference>$Record.OwnerId</elementReference></value></inputAssignments>
        <inputAssignments><field>Subject</field><value><stringValue>Rearrange missed periodic review</stringValue></value></inputAssignments>
        <inputAssignments><field>WhatId</field><value><elementReference>$Record.Id</elementReference></value></inputAssignments>
        <object>Task</object>
    </recordCreates>
    <recordLookups>
        <name>Get_Account</name><label>Get Account</label><locationX>0</locationX><locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector><targetReference>Update_Account</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters><field>Id</field><operator>EqualTo</operator><value><elementReference>$Record.AccountId</elementReference></value></filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Account</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Account</name><label>Update Account</label><locationX>0</locationX><locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters><field>Id</field><operator>EqualTo</operator><value><elementReference>$Record.AccountId</elementReference></value></filters>
        <inputAssignments><field>FF_Last_Review_Date__c</field><value><elementReference>LastDate</elementReference></value></inputAssignments>
        <inputAssignments><field>FF_Next_Review_Date__c</field><value><elementReference>NextDate</elementReference></value></inputAssignments>
        <object>Account</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX><locationY>0</locationY>
        <connector><targetReference>Which_Status</targetReference></connector>
        <filterFormula>AND(NOT(ISBLANK(TEXT({!$Record.FF_Review_Status__c}))), ISCHANGED({!$Record.FF_Review_Status__c}))</filterFormula>
        <object>ApplicationForm</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
