    <decisions>
        <description>Evaluates the origin of the screen flow by examining the first three digits of either the Product or Financial Account fields. Based on the prefix identified, the flow routes users to the appropriate path variant.</description>
        <name>Product_or_Financial_Account</name>
        <label>Product or Financial Account</label>
        <locationX>314</locationX>
        <locationY>134</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Product</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>recordId</leftValueReference>
                <operator>StartsWith</operator>
                <rightValue>
                    <stringValue>01t</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Product</targetReference>
            </connector>
            <label>Product</label>
        </rules>
        <rules>
            <name>Financial_Account</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>recordId</leftValueReference>
                <operator>StartsWith</operator>
                <rightValue>
                    <stringValue>0c7</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Financial_Account</targetReference>
            </connector>
            <label>Financial Account</label>
        </rules>
    </decisions>
    <description>Screen flow launched from the Product and Financial Account captures the details regarding a Regulator change and creates a case for the Compliance Team.</description>
    <environments>Default</environments>
    <formulas>
        <description>Displays the product based on where the flow is launched, either Product or Financial Account record page</description>
        <name>ProductDefaultValue</name>
        <dataType>String</dataType>
        <expression>IF({!Product},{!Get_Product.Name},{!Get_Financial_Account.Product.Name})</expression>
    </formulas>
    <formulas>
        <description>Creates the URL for the Product and appends the Product Id via the Financial Account OR Product record, depending where the flow is launched.</description>
        <name>ProductLinkFormula</name>
        <dataType>String</dataType>
        <expression>LEFT({!$Api.Partner_Server_URL_340},FIND(&quot;/services&quot;, {!$Api.Partner_Server_URL_340})) + &quot;/&quot; + IF({!Product},{!Get_Product.Id},{!Get_Financial_Account.Product.Id})</expression>
    </formulas>
