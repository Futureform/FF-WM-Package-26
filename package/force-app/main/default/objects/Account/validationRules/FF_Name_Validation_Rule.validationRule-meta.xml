<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>FF_Name_Validation_Rule</fullName>
    <active>false</active>
    <description>Invalid characters in Name</description>
    <errorConditionFormula>OR(
    NOT(REGEX(FirstName, &quot;^[A-Za-zÀ-ÖØ-öø-ÿ&apos;\\-\\.]+$&quot;)), 
    NOT(REGEX(MiddleName, &quot;^[A-Za-zÀ-ÖØ-öø-ÿ&apos;\\-\\.]*$&quot;)), 
    NOT(REGEX(LastName, &quot;^[A-Za-zÀ-ÖØ-öø-ÿ&apos;\\-\\.]+$&quot;)), 
    NOT(REGEX(FF_Preferred_Name__c, &quot;^[A-Za-zÀ-ÖØ-öø-ÿ&apos;\\-\\.]*$&quot;))
)</errorConditionFormula>
    <errorMessage>Names cannot include symbols or numbers</errorMessage>
</ValidationRule>
