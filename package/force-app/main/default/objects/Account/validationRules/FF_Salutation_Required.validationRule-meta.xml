<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>FF_Salutation_Required</fullName>
    <active>false</active>
    <description>Ensures salutation field is not left blank</description>
    <errorConditionFormula>ISBLANK(TEXT(Salutation))</errorConditionFormula>
    <errorMessage>Salutation must be populated</errorMessage>
</ValidationRule>
