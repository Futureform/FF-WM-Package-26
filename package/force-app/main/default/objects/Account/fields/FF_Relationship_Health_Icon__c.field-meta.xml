<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>FF_Relationship_Health_Icon__c</fullName>
    <description>Enables the user to see the client relationship status as a coloured bar based on the status: Green = Good, Yellow = Needs Improvement; Red = Not So Good</description>
    <externalId>false</externalId>
    <formula>IMAGE(
CASE(FF_Relationship_Health_Status__c,
&quot;Bad&quot;, &quot;/img/samples/color_red.gif&quot;,
&quot;Needs Improvement&quot;, &quot;/img/samples/color_yellow.gif&quot;,
&quot;Good&quot;, &quot;/img/samples/color_green.gif&quot;,
&quot;/s.gif&quot;),
&quot;Health&quot;, 16, 100)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Relationship Health</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
